# Downloads of pinned third-party files, with retries: release hosts (GitHub releases above all) answer with a 5xx now
# and then, and one failed request should not fail a whole build.
include_guard(GLOBAL)

# mhf_download(<url> <file> <sha256> <out>): fetches <url> to <file> unless <file> already has the pinned SHA-256, trying
# up to four times with a growing pause. <out> is set to an empty string on success, else to what went wrong last.
function(mhf_download url file sha256 out)
    if(EXISTS "${file}")
        file(SHA256 "${file}" existing)
        if(existing STREQUAL sha256)
            set(${out} "" PARENT_SCOPE)
            return()
        endif()
    endif()
    get_filename_component(folder "${file}" DIRECTORY)
    file(MAKE_DIRECTORY "${folder}")
    message(STATUS "mhf: downloading ${url}")
    set(problem "")
    foreach(attempt RANGE 1 4)
        if(attempt GREATER 1)
            math(EXPR pause "${attempt} * 15 - 15")
            message(STATUS "mhf: ${problem}; trying again in ${pause} s (attempt ${attempt} of 4)")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep ${pause})
        endif()
        file(DOWNLOAD "${url}" "${file}.part" STATUS status TLS_VERIFY ON)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            list(GET status 1 message)
            set(problem "could not download ${url}: ${message}")
            file(REMOVE "${file}.part")
            continue()
        endif()
        file(SHA256 "${file}.part" actual)
        if(NOT actual STREQUAL sha256)
            set(problem "${url} has SHA-256 ${actual}, expected ${sha256}")
            file(REMOVE "${file}.part")
            continue()
        endif()
        file(RENAME "${file}.part" "${file}")
        set(${out} "" PARENT_SCOPE)
        return()
    endforeach()
    set(${out} "${problem}" PARENT_SCOPE)
endfunction()
